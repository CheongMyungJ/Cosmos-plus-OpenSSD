+		gcVictimMapPtr->gcVictimList[dieNo][list].headBlock = head;
+		gcVictimMapPtr->gcVictimList[dieNo][list].tailBlock = tail;
+	}
+}
+
+void BlockListAppend(unsigned int dieNo, int list, unsigned int blockNo)
+{
+	unsigned int tail = ListTail(dieNo, list);
+
+	virtualBlockMapPtr->block[dieNo][blockNo].nextBlock = BLOCK_NONE;
+	virtualBlockMapPtr->block[dieNo][blockNo].prevBlock = tail;
+	if(tail != BLOCK_NONE)
+	{
+		virtualBlockMapPtr->block[dieNo][tail].nextBlock = blockNo;
+		SetListEnds(dieNo, list, ListHead(dieNo, list), blockNo);
 	}
+	else
+		SetListEnds(dieNo, list, blockNo, blockNo);
+}
+
+void BlockListRemove(unsigned int dieNo, int list, unsigned int blockNo)
+{
+	unsigned int prev = virtualBlockMapPtr->block[dieNo][blockNo].prevBlock;
+	unsigned int next = virtualBlockMapPtr->block[dieNo][blockNo].nextBlock;
+	unsigned int head = ListHead(dieNo, list), tail = ListTail(dieNo, list);
+
+	if(prev != BLOCK_NONE)
+		virtualBlockMapPtr->block[dieNo][prev].nextBlock = next;
+	else
+		head = next;
+	if(next != BLOCK_NONE)
+		virtualBlockMapPtr->block[dieNo][next].prevBlock = prev;
+	else
+		tail = prev;
+	SetListEnds(dieNo, list, head, tail);
 
+	virtualBlockMapPtr->block[dieNo][blockNo].prevBlock = BLOCK_NONE;
+	virtualBlockMapPtr->block[dieNo][blockNo].nextBlock = BLOCK_NONE;
+}
+
+void PutToFbList(unsigned int dieNo, unsigned int blockNo) //fb means free block
+{
+	BlockListAppend(dieNo, BLOCK_LIST_FREE, blockNo);
 	virtualDieMapPtr->die[dieNo].freeBlockCnt++;
