diff --git a/firmware/media_error.c b/firmware/media_error.c
new file mode 100644
index 0000000..05afebd
--- /dev/null
+++ b/firmware/media_error.c
@@ -0,0 +1,185 @@
+//////////////////////////////////////////////////////////////////////////////////
+// media_error.c: program failure rescue and block retirement — docs/design/media-errors.md
+//
+// When a program fails, the data of the request is copied to a rescue buffer (the data buffer entry is
+// reused as soon as the request ends). The main loop writes it again elsewhere and retires the block:
+// its valid data moves out and it never goes back to the free or GC lists.
+//////////////////////////////////////////////////////////////////////////////////
+
+#include <assert.h>
+#include <string.h>
+#include "xil_printf.h"
+#include "memory_map.h"
+#include "page_meta.h"
+
+#define RESCUE_BUF_BYTES (BYTES_PER_DATA_REGION_OF_PAGE + BYTES_PER_SPARE_REGION_OF_PAGE)
+
+static unsigned int rescueVsa[MAX_RESCUE_ENTRIES];
+static unsigned char rescueUsed[MAX_RESCUE_ENTRIES];
+static unsigned char retirePending[USER_DIES][USER_BLOCKS_PER_DIE];
+static unsigned int pendingCnt;
+static unsigned int processing;
+
+void RescueFailedProgram(unsigned int reqSlotTag)
+{
+	unsigned int vsa, dieNo, blockNo, i, addr;
+
+	if(reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandAddr != REQ_OPT_NAND_ADDR_VSA)
+		return;
+	vsa = reqPoolPtr->reqPool[reqSlotTag].nandInfo.virtualSliceAddr;
+	dieNo = Vsa2VdieTranslation(vsa);
+	blockNo = Vsa2VblockTranslation(vsa);
+	if(IsCheckpointBlock(dieNo, blockNo))
+		return;
+
+	retirePending[dieNo][blockNo] = 1;
+	pendingCnt++;
+	return;	//retire only
+
+	//user data: a data buffer entry, a GC temporary entry, or a rescue buffer being written again
+	if(reqPoolPtr->reqPool[reqSlotTag].reqOpt.dataBufFormat == REQ_OPT_DATA_BUF_ADDR)
+	{
+		addr = reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.addr;
+		if(addr < MEDIA_RESCUE_BUFFER_ADDR || addr >= MEDIA_RESCUE_BUFFER_ADDR + MAX_RESCUE_ENTRIES * RESCUE_BUF_BYTES)
+			return;
+	}
+	else if((reqPoolPtr->reqPool[reqSlotTag].reqOpt.dataBufFormat != REQ_OPT_DATA_BUF_ENTRY) && (reqPoolPtr->reqPool[reqSlotTag].reqOpt.dataBufFormat != REQ_OPT_DATA_BUF_TEMP_ENTRY))
+		return;
+
+	for(i = 0; i < MAX_RESCUE_ENTRIES; i++)
+		if(!rescueUsed[i])
+			break;
+	if(i == MAX_RESCUE_ENTRIES)
+		assert(!"[WARNING] No rescue buffer for a failed program [WARNING]");
+
+	addr = MEDIA_RESCUE_BUFFER_ADDR + i * RESCUE_BUF_BYTES;
+	memmove((void*)addr, (void*)GenerateDataBufAddr(reqSlotTag), BYTES_PER_DATA_REGION_OF_PAGE);
+	memmove((void*)(addr + BYTES_PER_DATA_REGION_OF_PAGE), (void*)GenerateSpareDataBufAddr(reqSlotTag), BYTES_PER_SPARE_REGION_OF_PAGE);
+	rescueVsa[i] = vsa;
+	rescueUsed[i] = 1;
+}
+
+/** a failed program not written again yet: its page holds nothing, GC must not copy it */
+int IsRescuePending(unsigned int virtualSliceAddr)
+{
+	unsigned int i;
+
+	for(i = 0; i < MAX_RESCUE_ENTRIES; i++)
+		if(rescueUsed[i] && rescueVsa[i] == virtualSliceAddr)
+			return 1;
+	return 0;
+}
+
+static void RewriteRescued(unsigned int i)
+{
+	unsigned int addr, lsa, seq, newVsa, reqSlotTag;
+
+	addr = MEDIA_RESCUE_BUFFER_ADDR + i * RESCUE_BUF_BYTES;
+	if(!ParsePageMeta(addr + BYTES_PER_DATA_REGION_OF_PAGE, &lsa, &seq) || lsa >= SLICES_PER_SSD)
+	{
+		rescueUsed[i] = 0;
+		return;
+	}
+	//the host wrote the slice again meanwhile: the rescued data is old
+	if(logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr != rescueVsa[i])
+	{
+		rescueUsed[i] = 0;
+		return;
+	}
+
+	newVsa = AddrTransWrite(lsa);
+	FillPageMeta(addr + BYTES_PER_DATA_REGION_OF_PAGE, lsa);
+
+	reqSlotTag = GetNandReq(REQ_CODE_WRITE, REQ_OPT_DATA_BUF_ADDR, REQ_OPT_NAND_ADDR_VSA, REQ_OPT_NAND_ECC_ON, REQ_OPT_NAND_ECC_WARNING_ON, REQ_OPT_ROW_ADDR_DEPENDENCY_CHECK, REQ_OPT_BLOCK_SPACE_MAIN);
+	reqPoolPtr->reqPool[reqSlotTag].logicalSliceAddr = lsa;
+	reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.addr = addr;
+	reqPoolPtr->reqPool[reqSlotTag].nandInfo.virtualSliceAddr = newVsa;
+	SelectLowLevelReqQ(reqSlotTag);
+	//the slot stays in use until the program ends (another failure meanwhile must not take it). If this program
+	//fails too, its data is rescued again into another slot
+	SyncAllLowLevelReqDone();
+	rescueUsed[i] = 0;
+}
+
+static void RetireBlock(unsigned int dieNo, unsigned int blockNo)
+{
+	P_VIRTUAL_BLOCK_ENTRY block = &virtualBlockMapPtr->block[dieNo][blockNo];
+
+	xil_printf("[ retire die %d block %d ]\r\n", dieNo, blockNo);
+	if(block->free)
+	{
+		//a free block that failed: take it out of the free block list
+		unsigned int prev = block->prevBlock, next = block->nextBlock;
+		if(prev != BLOCK_NONE)
+			virtualBlockMapPtr->block[dieNo][prev].nextBlock = next;
+		else
+			virtualDieMapPtr->die[dieNo].headFreeBlock = next;
+		if(next != BLOCK_NONE)
+			virtualBlockMapPtr->block[dieNo][next].prevBlock = prev;
+		else
+			virtualDieMapPtr->die[dieNo].tailFreeBlock = prev;
+		virtualDieMapPtr->die[dieNo].freeBlockCnt--;
+		block->free = 0;
+	}
+	else
+	{
+		if(block->invalidSliceCnt)
+			SelectiveGetFromGcVictimList(dieNo, blockNo);
+		//moves the valid slices out (takes another current block if this one is current)
+		RelocateValidData(dieNo, blockNo);
+		SyncAllLowLevelReqDone();
+		if(virtualDieMapPtr->die[dieNo].currentBlock == blockNo)
+		{
+			virtualDieMapPtr->die[dieNo].currentBlock = GetFromFbList(dieNo, GET_FREE_BLOCK_GC);
+			if(virtualDieMapPtr->die[dieNo].currentBlock == BLOCK_FAIL)
+				assert(!"[WARNING] There is no available block [WARNING]");
+		}
+	}
+	block->bad = 1;
+	block->currentPage = USER_PAGES_PER_BLOCK;
+	block->prevBlock = BLOCK_NONE;
+	block->nextBlock = BLOCK_NONE;
+}
+
+void ProcessMediaFailures()
+{
+	unsigned int i, dieNo, blockNo, again;
+
+	if(!pendingCnt || processing)
+		return;
+	processing = 1;
+
+	do
+	{
+		again = 0;
+		//stop writing to the failed blocks first, so the rescued data goes elsewhere
+		for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+		{
+			blockNo = virtualDieMapPtr->die[dieNo].currentBlock;
+			if(retirePending[dieNo][blockNo])
+				virtualBlockMapPtr->block[dieNo][blockNo].currentPage = USER_PAGES_PER_BLOCK;
+		}
+		for(i = 0; i < MAX_RESCUE_ENTRIES; i++)
+			if(rescueUsed[i])
+				RewriteRescued(i);
+		for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+			for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+				if(retirePending[dieNo][blockNo])
+				{
+					retirePending[dieNo][blockNo] = 0;
+					if(!virtualBlockMapPtr->block[dieNo][blockNo].bad)
+						RetireBlock(dieNo, blockNo);
+					again = 1;
+				}
+		pendingCnt = 0;
+		for(i = 0; i < MAX_RESCUE_ENTRIES; i++)
+			if(rescueUsed[i])
+				pendingCnt++;
+		for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+			for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+				if(retirePending[dieNo][blockNo])
+					pendingCnt++;
+	} while(again && pendingCnt);
+
+	processing = 0;
+}
