+/**
+ * a host read of a slice failed after the retries (docs/design/media-errors.md): complete its command with
+ * Unrecovered Read Error and drop the data buffer entry so that the next read goes to NAND again
+ */
+void ReportUnrecoveredRead(unsigned int reqSlotTag)
+{
+	NVME_COMPLETION nvmeCPL;
+	unsigned int bufEntry = reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.entry;
+
+	nvmeCPL.dword[0] = 0;
+	nvmeCPL.specific = 0x0;
+	nvmeCPL.statusField.SCT = SCT_MEDIA_AND_DATA_INTEGRITY_ERRORS;
+	nvmeCPL.statusField.SC = SC_UNRECOVERED_READ_ERROR;
+	set_auto_nvme_cpl(reqPoolPtr->reqPool[reqSlotTag].nvmeCmdSlotTag, nvmeCPL.specific, nvmeCPL.statusFieldWord);
+
+	if((dataBufMapPtr->dataBuf[bufEntry].dirty == DATA_BUF_CLEAN) && (dataBufMapPtr->dataBuf[bufEntry].logicalSliceAddr == reqPoolPtr->reqPool[reqSlotTag].logicalSliceAddr))
+	{
+		SelectiveGetFromDataBufHashList(bufEntry);
+		dataBufMapPtr->dataBuf[bufEntry].logicalSliceAddr = LSA_NONE;
+	}
+}
+
 void ExecuteNandReq(unsigned int chNo, unsigned int wayNo, unsigned int reqStatus)
 {
