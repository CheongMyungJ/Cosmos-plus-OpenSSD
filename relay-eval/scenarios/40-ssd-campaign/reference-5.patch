+/**
+ * zero a part of a slice (docs/design/trim.md 4): bring the slice into a data buffer entry like a partial write does
+ * (read-modify-write), clear the deallocated blocks and leave the entry dirty
+ */
+static void ZeroPartOfSlice(unsigned int logicalSliceAddr, unsigned int blockOffset, unsigned int numOfBlocks)
+{
+	unsigned int reqSlotTag, bufEntry;
+
+	reqSlotTag = GetFromFreeReqQ();
+	reqPoolPtr->reqPool[reqSlotTag].reqType = REQ_TYPE_SLICE;
+	reqPoolPtr->reqPool[reqSlotTag].reqCode = REQ_CODE_WRITE;
+	reqPoolPtr->reqPool[reqSlotTag].nvmeCmdSlotTag = 0;
+	reqPoolPtr->reqPool[reqSlotTag].logicalSliceAddr = logicalSliceAddr;
+	reqPoolPtr->reqPool[reqSlotTag].nvmeDmaInfo.nvmeBlockOffset = blockOffset;
+	reqPoolPtr->reqPool[reqSlotTag].nvmeDmaInfo.numOfNvmeBlock = numOfBlocks;
+
+	bufEntry = CheckDataBufHit(reqSlotTag);
+	if(bufEntry == DATA_BUF_FAIL)
+	{
+		bufEntry = AllocateDataBuf();
+		reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.entry = bufEntry;
+		EvictDataBufEntry(reqSlotTag);
+		dataBufMapPtr->dataBuf[bufEntry].logicalSliceAddr = logicalSliceAddr;
+		PutToDataBufHashList(bufEntry);
+		DataReadFromNand(reqSlotTag);
+	}
+	reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.entry = bufEntry;
+
+	if(dataBufMapPtr->dataBuf[bufEntry].blockingReqTail != REQ_SLOT_TAG_NONE)
+		SyncAllLowLevelReqDone();
+
+	memset((void*)(DATA_BUFFER_BASE_ADDR + bufEntry * BYTES_PER_DATA_REGION_OF_SLICE + blockOffset * BYTES_PER_NVME_BLOCK), 0, numOfBlocks * BYTES_PER_NVME_BLOCK);
+	dataBufMapPtr->dataBuf[bufEntry].dirty = DATA_BUF_DIRTY;
+
+	PutToFreeReqQ(reqSlotTag);
+}
