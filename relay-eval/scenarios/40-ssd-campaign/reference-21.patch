+void SchedulingNandReqPerCh(unsigned int chNo)
+{
+	unsigned int waitWayCnt = 0;
 
+	if(wayPriorityTablePtr->wayPriority[chNo].idleHead != WAY_NONE)
+		waitWayCnt += ScheduleIdleWays(chNo);
+	if(wayPriorityTablePtr->wayPriority[chNo].statusReportHead != WAY_NONE)
+		waitWayCnt += CompleteReportedWays(chNo);
+
+	if(waitWayCnt == USER_WAYS || V2FIsControllerBusy(chCtlReg[chNo]))
+		return;
+
+	//the order is the latency requirement: status, read triggers before erases and writes, read transfers last
+	if(wayPriorityTablePtr->wayPriority[chNo].statusCheckHead != WAY_NONE)
+		if(IssueStatusChecks(chNo))
+			return;
+	if(IssueFromPriorityList(chNo, wayPriorityTablePtr->wayPriority[chNo].readTriggerHead, SelectiveGetFromNandReadTriggerList, PutToNandStatusCheckList))
+		return;
+	if(IssueFromPriorityList(chNo, wayPriorityTablePtr->wayPriority[chNo].eraseHead, SelectiveGetFromNandEraseList, PutToNandStatusCheckList))
+		return;
+	if(IssueFromPriorityList(chNo, wayPriorityTablePtr->wayPriority[chNo].writeHead, SelectiveGetFromNandWriteList, PutToNandStatusCheckList))
+		return;
+	IssueFromPriorityList(chNo, wayPriorityTablePtr->wayPriority[chNo].readTransferHead, SelectiveGetFromNandReadTransferList, PutToNandStatusReportList);
 }
 
