index 0000000..ce45a45
--- /dev/null
+++ b/firmware/smart.h
@@ -0,0 +1,29 @@
+//////////////////////////////////////////////////////////////////////////////////
+// smart.h: SMART / Health Information log page — docs/design/smart.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#ifndef SMART_H_
+#define SMART_H_
+
+#define SMART_LOG_BYTES					512
+#define SMART_RATED_PE_CYCLES			3000	//docs/design/wear-leveling.md
+#define SMART_SPARE_THRESHOLD			10
+#define SMART_TEMPERATURE_KELVIN		313
+
+typedef struct _SMART_COUNTERS {
+	unsigned long long units512Read;		//512-byte units moved by host reads
+	unsigned long long units512Written;
+	unsigned long long hostReadCommands;
+	unsigned long long hostWriteCommands;
+	unsigned long long mediaErrors;
+	unsigned long long powerCycles;
+	unsigned long long unsafeShutdowns;
+} SMART_COUNTERS;
+
+extern SMART_COUNTERS g_smart;
+
+void SmartCountRead(unsigned int numOfBlocks);
+void SmartCountWrite(unsigned int numOfBlocks);
+void FillSmartLog(unsigned char* log);
+
+#endif /* SMART_H_ */
