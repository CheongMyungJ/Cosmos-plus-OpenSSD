+++ b/firmware/nvme/nvme_io_cmd.h
@@ -48,5 +48,7 @@
 #define __NVME_IO_CMD_H_
 
 void handle_nvme_io_cmd(NVME_COMMAND *nvmeCmd);
+int IsLbaRangeInNamespace(unsigned int startLba[2], unsigned int numOfBlocks);
+void CompleteLbaOutOfRange(unsigned int cmdSlotTag);
 
 #endif	//__NVME_IO_CMD_H_
