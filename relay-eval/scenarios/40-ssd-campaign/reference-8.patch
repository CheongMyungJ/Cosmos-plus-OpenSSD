diff --git a/firmware/checkpoint.c b/firmware/checkpoint.c
new file mode 100644
index 0000000..cfa2ca1
--- /dev/null
+++ b/firmware/checkpoint.c
@@ -0,0 +1,305 @@
+//////////////////////////////////////////////////////////////////////////////////
+// checkpoint.c: checkpoint and boot recovery — docs/design/power-loss.md
+//
+// Every user data page carries its logical slice and a write sequence in the spare (page_meta.c).
+// At boot every user page is read: for each logical slice the page with the largest sequence wins.
+// A checkpoint records which logical slices are unmapped (deallocated) at a sequence, so data older
+// than the checkpoint does not come back for them.
+//////////////////////////////////////////////////////////////////////////////////
+
+#include <assert.h>
+#include <string.h>
+#include "xil_printf.h"
+#include "memory_map.h"
+#include "page_meta.h"
+
+#define PAGE_BUF_BYTES (BYTES_PER_DATA_REGION_OF_PAGE + BYTES_PER_SPARE_REGION_OF_PAGE)
+
+P_RECOVERY_SEQ_TABLE recoverySeqTablePtr;
+
+static unsigned int checkpointBlock;		//block being appended
+static unsigned int checkpointNextPage;		//next free page in it
+
+static void IssueCheckpointNandReq(unsigned int reqCode, unsigned int dieNo, unsigned int blockNo, unsigned int pageNo, unsigned int bufAddr)
+{
+	unsigned int reqSlotTag = GetFromFreeReqQ();
+
+	reqPoolPtr->reqPool[reqSlotTag].reqType = REQ_TYPE_NAND;
+	reqPoolPtr->reqPool[reqSlotTag].reqCode = reqCode;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.dataBufFormat = (reqCode == REQ_CODE_ERASE) ? REQ_OPT_DATA_BUF_NONE : REQ_OPT_DATA_BUF_ADDR;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandAddr = REQ_OPT_NAND_ADDR_VSA;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandEcc = REQ_OPT_NAND_ECC_ON;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandEccWarning = REQ_OPT_NAND_ECC_WARNING_OFF;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.rowAddrDependencyCheck = REQ_OPT_ROW_ADDR_DEPENDENCY_NONE;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.blockSpace = REQ_OPT_BLOCK_SPACE_MAIN;
+	reqPoolPtr->reqPool[reqSlotTag].dataBufInfo.addr = bufAddr;
+	reqPoolPtr->reqPool[reqSlotTag].nandInfo.virtualSliceAddr = Vorg2VsaTranslation(dieNo, blockNo, pageNo);
+	reqPoolPtr->reqPool[reqSlotTag].nandInfo.programmedPageCnt = USER_PAGES_PER_BLOCK;
+
+	SelectLowLevelReqQ(reqSlotTag);
+}
+
+/** write the unmapped state of every logical slice (the whole logical-to-virtual map) with the current write sequence */
+void WriteCheckpoint()
+{
+	unsigned int page, bytes;
+	P_CHECKPOINT_HEADER header;
+
+	//the map must only point at pages that are already programmed
+	SyncAllLowLevelReqDone();
+
+	if(checkpointNextPage + CHECKPOINT_PAGES > USER_PAGES_PER_BLOCK)
+	{
+		checkpointBlock = (checkpointBlock == CHECKPOINT_BLOCK0) ? CHECKPOINT_BLOCK1 : CHECKPOINT_BLOCK0;
+		IssueCheckpointNandReq(REQ_CODE_ERASE, CHECKPOINT_DIE, checkpointBlock, 0, 0);
+		SyncAllLowLevelReqDone();
+		checkpointNextPage = 0;
+	}
+
+	memset((void*)CHECKPOINT_BUFFER_ADDR, 0xFF, CHECKPOINT_PAGES * PAGE_BUF_BYTES);
+	for(page = 0; page < CHECKPOINT_MAP_PAGES; page++)
+	{
+		bytes = CHECKPOINT_MAP_BYTES - page * BYTES_PER_DATA_REGION_OF_PAGE;
+		if(bytes > BYTES_PER_DATA_REGION_OF_PAGE)
+			bytes = BYTES_PER_DATA_REGION_OF_PAGE;
+		memcpy((void*)(CHECKPOINT_BUFFER_ADDR + page * PAGE_BUF_BYTES), (unsigned char*)logicalSliceMapPtr + page * BYTES_PER_DATA_REGION_OF_PAGE, bytes);
+	}
+
+	header = (P_CHECKPOINT_HEADER)(CHECKPOINT_BUFFER_ADDR + CHECKPOINT_MAP_PAGES * PAGE_BUF_BYTES);
+	header->magic = CHECKPOINT_MAGIC;
+	header->version = CHECKPOINT_VERSION;
+	header->checkpointSeq = g_writeSeq;
+	header->mapPages = CHECKPOINT_MAP_PAGES;
+	header->mapCrc = Crc32(logicalSliceMapPtr, CHECKPOINT_MAP_BYTES);
+	header->headerCrc = Crc32(header, 20);
+
+	//map pages first, the header last: a checkpoint without its header does not count
+	for(page = 0; page < CHECKPOINT_PAGES; page++)
+		IssueCheckpointNandReq(REQ_CODE_WRITE, CHECKPOINT_DIE, checkpointBlock, checkpointNextPage + page, CHECKPOINT_BUFFER_ADDR + page * PAGE_BUF_BYTES);
+	SyncAllLowLevelReqDone();
+
+	checkpointNextPage += CHECKPOINT_PAGES;
+}
+
+static unsigned int ReadPageOfDie(unsigned int dieNo, unsigned int blockNo, unsigned int pageNo)
+{
+	unsigned int addr = RECOVERY_READ_BUFFER_ADDR + dieNo * PAGE_BUF_BYTES;
+	IssueCheckpointNandReq(REQ_CODE_READ, dieNo, blockNo, pageNo, addr);
+	SyncAllLowLevelReqDone();
+	return addr;
+}
+
+/**
+ * find the newest checkpoint whose header and map CRC are right and load its map into logicalSliceMap.
+ * @return 1 if found (*checkpointSeq set)
+ */
+static int LoadCheckpoint(unsigned int* checkpointSeq)
+{
+	unsigned int b, block, page, addr, found, bestBlock, bestPage, bestSeq, usedPages[2];
+	P_CHECKPOINT_HEADER header;
+
+	found = 0;
+	bestBlock = CHECKPOINT_BLOCK0;
+	bestPage = 0;
+	bestSeq = 0;
+	for(b = 0; b < 2; b++)
+	{
+		block = b ? CHECKPOINT_BLOCK1 : CHECKPOINT_BLOCK0;
+		usedPages[b] = 0;
+		for(page = 0; page < USER_PAGES_PER_BLOCK; page++)
+		{
+			addr = ReadPageOfDie(CHECKPOINT_DIE, block, page);
+			if(!IsErasedPageMeta(addr + BYTES_PER_DATA_REGION_OF_PAGE) || *(unsigned int*)addr != 0xFFFFFFFF)
+				usedPages[b] = page + 1;
+			header = (P_CHECKPOINT_HEADER)addr;
+			if(header->magic != CHECKPOINT_MAGIC || header->version != CHECKPOINT_VERSION || header->mapPages != CHECKPOINT_MAP_PAGES)
+				continue;
+			if(header->headerCrc != Crc32(header, 20) || page < CHECKPOINT_MAP_PAGES)
+				continue;
+			if(!found || header->checkpointSeq > bestSeq)
+			{
+				found = 1;
+				bestBlock = block;
+				bestPage = page;
+				bestSeq = header->checkpointSeq;
+			}
+		}
+	}
+
+	if(found)
+	{
+		unsigned int mapCrc;
+		addr = ReadPageOfDie(CHECKPOINT_DIE, bestBlock, bestPage);
+		mapCrc = ((P_CHECKPOINT_HEADER)addr)->mapCrc;
+		for(page = 0; page < CHECKPOINT_MAP_PAGES; page++)
+		{
+			unsigned int bytes = CHECKPOINT_MAP_BYTES - page * BYTES_PER_DATA_REGION_OF_PAGE;
+			if(bytes > BYTES_PER_DATA_REGION_OF_PAGE)
+				bytes = BYTES_PER_DATA_REGION_OF_PAGE;
+			addr = ReadPageOfDie(CHECKPOINT_DIE, bestBlock, bestPage - CHECKPOINT_MAP_PAGES + page);
+			memcpy((unsigned char*)logicalSliceMapPtr + page * BYTES_PER_DATA_REGION_OF_PAGE, (void*)addr, bytes);
+		}
+		if(mapCrc != Crc32(logicalSliceMapPtr, CHECKPOINT_MAP_BYTES))
+		{
+			xil_printf("[ checkpoint map CRC mismatch: ignored ]\r\n");
+			found = 0;
+		}
+	}
+
+	//append to the block holding the newest checkpoint. Without one, start over in block 0 (erased on first write)
+	if(found)
+	{
+		checkpointBlock = bestBlock;
+		checkpointNextPage = usedPages[bestBlock == CHECKPOINT_BLOCK1];
+		*checkpointSeq = bestSeq;
+	}
+	else
+	{
+		checkpointBlock = CHECKPOINT_BLOCK1;
+		checkpointNextPage = USER_PAGES_PER_BLOCK;
+	}
+	return found;
+}
+
+void RecoverFtl()
+{
+	unsigned int dieNo, blockNo, pageNo, addr, lsa, seq, vsa, hasCheckpoint, checkpointSeq, maxSeq, programmed, valid;
+	static unsigned char unmappedAtCheckpoint[SLICES_PER_SSD / 8 + 1];
+	static unsigned int blockMaxSeqPlusOne[USER_DIES][USER_BLOCKS_PER_DIE];
+	unsigned int resumeBlock, resumeSeq;
+
+	recoverySeqTablePtr = (P_RECOVERY_SEQ_TABLE) RECOVERY_SEQ_TABLE_ADDR;
+	memset(recoverySeqTablePtr, 0, sizeof(RECOVERY_SEQ_TABLE));
+	memset(blockMaxSeqPlusOne, 0, sizeof(blockMaxSeqPlusOne));
+
+	checkpointSeq = 0;
+	hasCheckpoint = LoadCheckpoint(&checkpointSeq);
+	memset(unmappedAtCheckpoint, 0, sizeof(unmappedAtCheckpoint));
+	for(lsa = 0; lsa < SLICES_PER_SSD; lsa++)
+	{
+		if(hasCheckpoint && logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr == VSA_NONE)
+			unmappedAtCheckpoint[lsa / 8] |= (1 << (lsa % 8));
+		logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr = VSA_NONE;
+		virtualSliceMapPtr->virtualSlice[lsa].logicalSliceAddr = LSA_NONE;
+	}
+
+	//read the meta of every user page: the page with the largest sequence of a logical slice wins
+	maxSeq = hasCheckpoint ? checkpointSeq : 0;
+	for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+		for(pageNo = 0; pageNo < USER_PAGES_PER_BLOCK; pageNo++)
+		{
+			for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+				if(!virtualBlockMapPtr->block[dieNo][blockNo].bad && !IsCheckpointBlock(dieNo, blockNo))
+					IssueCheckpointNandReq(REQ_CODE_READ, dieNo, blockNo, pageNo, RECOVERY_READ_BUFFER_ADDR + dieNo * PAGE_BUF_BYTES);
+			SyncAllLowLevelReqDone();
+
+			for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+			{
+				if(virtualBlockMapPtr->block[dieNo][blockNo].bad || IsCheckpointBlock(dieNo, blockNo))
+					continue;
+				addr = RECOVERY_READ_BUFFER_ADDR + dieNo * PAGE_BUF_BYTES;
+				vsa = Vorg2VsaTranslation(dieNo, blockNo, pageNo);
+				if(!IsErasedPageMeta(addr + BYTES_PER_DATA_REGION_OF_PAGE))
+					virtualBlockMapPtr->block[dieNo][blockNo].currentPage = pageNo + 1;	//programmed up to here
+				if(!ParsePageMeta(addr + BYTES_PER_DATA_REGION_OF_PAGE, &lsa, &seq) || lsa >= SLICES_PER_SSD)
+					continue;
+				virtualSliceMapPtr->virtualSlice[vsa].logicalSliceAddr = lsa;
+				if(seq + 1 > blockMaxSeqPlusOne[dieNo][blockNo])
+					blockMaxSeqPlusOne[dieNo][blockNo] = seq + 1;
+				if(seq + 1 > maxSeq)
+					maxSeq = seq + 1;
+				if(recoverySeqTablePtr->seqPlusOne[lsa] <= seq)
+				{
+					recoverySeqTablePtr->seqPlusOne[lsa] = seq + 1;
+					logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr = vsa;
+				}
+			}
+		}
+
+	//deallocated at the checkpoint and not written since: stays unmapped
+	for(lsa = 0; lsa < SLICES_PER_SSD; lsa++)
+		if((unmappedAtCheckpoint[lsa / 8] & (1 << (lsa % 8))) && recoverySeqTablePtr->seqPlusOne[lsa] <= checkpointSeq)
+			logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr = VSA_NONE;
+
+	//rebuild the block states: unwritten blocks are free. Of the partly written blocks of a die, the one written last
+	//is the current block again (writing continues after its last page); other written blocks are closed and their
+	//stale pages count as invalid
+	for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+	{
+		virtualDieMapPtr->die[dieNo].headFreeBlock = BLOCK_NONE;
+		virtualDieMapPtr->die[dieNo].tailFreeBlock = BLOCK_NONE;
+		virtualDieMapPtr->die[dieNo].freeBlockCnt = 0;
+	}
+	for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+	{
+		resumeBlock = BLOCK_NONE;
+		resumeSeq = 0;
+		for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+		{
+			programmed = virtualBlockMapPtr->block[dieNo][blockNo].currentPage;
+			if(virtualBlockMapPtr->block[dieNo][blockNo].bad || IsCheckpointBlock(dieNo, blockNo))
+				continue;
+			if(programmed > 0 && programmed < USER_PAGES_PER_BLOCK && blockMaxSeqPlusOne[dieNo][blockNo] >= resumeSeq)
+			{
+				resumeBlock = blockNo;
+				resumeSeq = blockMaxSeqPlusOne[dieNo][blockNo];
+			}
+		}
+
+		for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+		{
+			P_VIRTUAL_BLOCK_ENTRY block = &virtualBlockMapPtr->block[dieNo][blockNo];
+			block->prevBlock = BLOCK_NONE;
+			block->nextBlock = BLOCK_NONE;
+			if(block->bad || IsCheckpointBlock(dieNo, blockNo))
+			{
+				block->free = 0;
+				continue;
+			}
+			programmed = block->currentPage;
+			valid = 0;
+			for(pageNo = 0; pageNo < USER_PAGES_PER_BLOCK; pageNo++)
+			{
+				vsa = Vorg2VsaTranslation(dieNo, blockNo, pageNo);
+				lsa = virtualSliceMapPtr->virtualSlice[vsa].logicalSliceAddr;
+				if(lsa != LSA_NONE && logicalSliceMapPtr->logicalSlice[lsa].virtualSliceAddr == vsa)
+					valid++;
+				else
+					virtualSliceMapPtr->virtualSlice[vsa].logicalSliceAddr = LSA_NONE;
+			}
+			if(programmed == 0)
+			{
+				block->invalidSliceCnt = 0;
+				block->free = 1;
+				PutToFbList(dieNo, blockNo);
+			}
+			else
+			{
+				block->free = 0;
+				if(blockNo != resumeBlock)
+					block->currentPage = USER_PAGES_PER_BLOCK;
+				block->invalidSliceCnt = block->currentPage - valid;
+				if(block->invalidSliceCnt)
+					PutToGcVictimList(dieNo, blockNo, block->invalidSliceCnt);
+			}
+			//reads of a page are held until the page is programmed (CheckRowAddrDep): pages written before the power
+			//loss are already programmed, and a closed block may be erased with all its pages counted
+			rowAddrDependencyTablePtr->block[Vdie2PchTranslation(dieNo)][Vdie2PwayTranslation(dieNo)][blockNo].permittedProgPage =
+				block->currentPage;
+		}
+
+		if(resumeBlock != BLOCK_NONE)
+			virtualDieMapPtr->die[dieNo].currentBlock = resumeBlock;
+		else
+		{
+			virtualDieMapPtr->die[dieNo].currentBlock = GetFromFbList(dieNo, GET_FREE_BLOCK_NORMAL);
+			if(virtualDieMapPtr->die[dieNo].currentBlock == BLOCK_FAIL)
+				virtualDieMapPtr->die[dieNo].currentBlock = GetFromFbList(dieNo, GET_FREE_BLOCK_GC);
+			if(virtualDieMapPtr->die[dieNo].currentBlock == BLOCK_FAIL)
+				assert(!"[WARNING] There is no free block after recovery [WARNING]");
+		}
+	}
+
+	g_writeSeq = maxSeq;
+	xil_printf("[ recovery done: checkpoint %d, next write sequence %d ]\r\n", hasCheckpoint, g_writeSeq);
+}
diff --git a/firmware/checkpoint.h b/firmware/checkpoint.h
