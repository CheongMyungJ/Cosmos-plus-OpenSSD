diff --git a/firmware/request_allocation.c b/firmware/request_allocation.c
index 1328ce5..47b049b 100644
--- a/firmware/request_allocation.c
+++ b/firmware/request_allocation.c
@@ -424,3 +424,25 @@ void GetFromNandReqQ(unsigned int chNo, unsigned int wayNo, unsigned int reqStat
 	PutToFreeReqQ(reqSlotTag);
 	ReleaseBlockedByBufDepReq(reqSlotTag);
 }
+
+
+/**
+ * take a free request slot for a NAND request and fill its type, code and options.
+ * the caller fills the address and the data buffer
+ */
+unsigned int GetNandReq(unsigned int reqCode, unsigned int dataBufFormat, unsigned int nandAddr, unsigned int nandEcc,
+		unsigned int nandEccWarning, unsigned int rowAddrDependencyCheck, unsigned int blockSpace)
+{
+	unsigned int reqSlotTag = GetFromFreeReqQ();
+
+	reqPoolPtr->reqPool[reqSlotTag].reqType = REQ_TYPE_NAND;
+	reqPoolPtr->reqPool[reqSlotTag].reqCode = reqCode;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.dataBufFormat = dataBufFormat;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandAddr = nandAddr;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandEcc = nandEcc;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.nandEccWarning = nandEccWarning;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.rowAddrDependencyCheck = rowAddrDependencyCheck;
+	reqPoolPtr->reqPool[reqSlotTag].reqOpt.blockSpace = blockSpace;
+
+	return reqSlotTag;
+}
