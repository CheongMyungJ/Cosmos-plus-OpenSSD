+//////////////////////////////////////////////////////////////////////////////////
+// trim.h: Dataset Management (Deallocate) — docs/design/trim.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#ifndef TRIM_H_
+#define TRIM_H_
+
+#include "nvme/nvme.h"
+
+typedef struct _DSM_RANGE {
+	unsigned int contextAttributes;
+	unsigned int length;
+	unsigned int startingLba[2];
+} DSM_RANGE, *P_DSM_RANGE;
+
+#define DSM_MAX_RANGES		256
+
+void handle_nvme_io_dataset_management(unsigned int cmdSlotTag, NVME_IO_COMMAND *nvmeIOCmd);
+void DeallocateLogicalSlice(unsigned int logicalSliceAddr);
+
+#endif /* TRIM_H_ */
