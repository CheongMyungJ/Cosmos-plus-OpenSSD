+void GarbageCollection(unsigned int dieNo)
+{
+	RelocateBlock(dieNo, GetFromGcVictimList(dieNo));
+	StaticWearLeveling(dieNo);
+}
+
+/**
+ * static wear leveling (docs/design/wear-leveling.md): when the most erased block of the die is erased more than
+ * WEAR_LEVELING_THRESHOLD times as often as the least erased block holding data, move the data of the latter
+ * (the lowest number on a tie) so that the block joins the free blocks. At most one block per GC
+ */
+void StaticWearLeveling(unsigned int dieNo)
+{
+	unsigned int blockNo, maxEraseCnt, coldBlock;
+	P_VIRTUAL_BLOCK_ENTRY block;
+
+	maxEraseCnt = 0;
+	coldBlock = BLOCK_NONE;
+	for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+	{
+		block = &virtualBlockMapPtr->block[dieNo][blockNo];
+		if(block->bad || IsCheckpointBlock(dieNo, blockNo))
+			continue;
+		if(block->eraseCnt > maxEraseCnt)
+			maxEraseCnt = block->eraseCnt;
+		if(block->free || blockNo == virtualDieMapPtr->die[dieNo].currentBlock)
+			continue;
+		if(coldBlock == BLOCK_NONE || block->eraseCnt < virtualBlockMapPtr->block[dieNo][coldBlock].eraseCnt)
+			coldBlock = blockNo;
+	}
+
+	if(coldBlock == BLOCK_NONE || maxEraseCnt - virtualBlockMapPtr->block[dieNo][coldBlock].eraseCnt <= WEAR_LEVELING_THRESHOLD)
+		return;
+
+	if(virtualBlockMapPtr->block[dieNo][coldBlock].invalidSliceCnt)
+		SelectiveGetFromGcVictimList(dieNo, coldBlock);
+	RelocateBlock(dieNo, coldBlock);
+}
