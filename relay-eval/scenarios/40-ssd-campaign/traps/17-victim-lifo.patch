diff --git a/firmware/smart.c b/firmware/smart.c
new file mode 100644
index 0000000..fe572de
--- /dev/null
+++ b/firmware/smart.c
@@ -0,0 +1,96 @@
+//////////////////////////////////////////////////////////////////////////////////
+// smart.c: SMART / Health Information log page — docs/design/smart.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#include <string.h>
+#include "memory_map.h"
+#include "smart.h"
+
+SMART_COUNTERS g_smart;
+
+void SmartCountRead(unsigned int numOfBlocks)
+{
+	g_smart.hostReadCommands++;
+	g_smart.units512Read += (unsigned long long)numOfBlocks * (BYTES_PER_NVME_BLOCK / 512);
+}
+
+void SmartCountWrite(unsigned int numOfBlocks)
+{
+	g_smart.hostWriteCommands++;
+	g_smart.units512Written += (unsigned long long)numOfBlocks * (BYTES_PER_NVME_BLOCK / 512);
+}
+
+static void Put128(unsigned char* p, unsigned long long v)
+{
+	memset(p, 0, 16);
+	memcpy(p, &v, 8);
+}
+
+/** remaining spare blocks for bad block replacement, 100 at first (one spare per die always replaces the block of the bad block table) */
+static unsigned int AvailableSpare()
+{
+	unsigned int dieNo, lun, blockNo, phyBlockNo, used, unused, initial;
+	unsigned char isTarget;
+
+	unused = 0;
+	for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+		for(lun = 0; lun < LUNS_PER_DIE; lun++)
+			for(blockNo = USER_BLOCKS_PER_LUN; blockNo < TOTAL_BLOCKS_PER_LUN; blockNo++)
+			{
+				phyBlockNo = lun * TOTAL_BLOCKS_PER_LUN + blockNo;
+				if(phyBlockMapPtr->phyBlock[dieNo][phyBlockNo].bad)
+					continue;
+				isTarget = 0;
+				for(used = 0; used < TOTAL_BLOCKS_PER_DIE; used++)
+					if(used != phyBlockNo && phyBlockMapPtr->phyBlock[dieNo][used].remappedPhyBlock == phyBlockNo)
+						isTarget = 1;
+				if(!isTarget)
+					unused++;
+			}
+	initial = USER_DIES * (LUNS_PER_DIE * (TOTAL_BLOCKS_PER_LUN - USER_BLOCKS_PER_LUN) - 1);
+	if(unused >= initial)
+		return 100;
+	return unused * 100 / initial;
+}
+
+static unsigned int PercentageUsed()
+{
+	unsigned int dieNo, blockNo, blocks;
+	unsigned long long erases, used;
+
+	erases = 0;
+	blocks = 0;
+	for(dieNo = 0; dieNo < USER_DIES; dieNo++)
+		for(blockNo = 0; blockNo < USER_BLOCKS_PER_DIE; blockNo++)
+			if(!virtualBlockMapPtr->block[dieNo][blockNo].bad)
+			{
+				erases += virtualBlockMapPtr->block[dieNo][blockNo].eraseCnt;
+				blocks++;
+			}
+	if(!blocks)
+		return 0;
+	//average erase count / rated cycles, as a percentage rounded up
+	used = (erases * 100 + (unsigned long long)SMART_RATED_PE_CYCLES * blocks - 1) / ((unsigned long long)SMART_RATED_PE_CYCLES * blocks);
+	return used > 255 ? 255 : (unsigned int)used;
+}
+
+void FillSmartLog(unsigned char* log)
+{
+	unsigned int spare = AvailableSpare();
+
+	memset(log, 0, SMART_LOG_BYTES);
+	log[0] = (spare < SMART_SPARE_THRESHOLD) ? 0x1 : 0x0;
+	log[1] = SMART_TEMPERATURE_KELVIN & 0xFF;
+	log[2] = SMART_TEMPERATURE_KELVIN >> 8;
+	log[3] = spare;
+	log[4] = SMART_SPARE_THRESHOLD;
+	log[5] = PercentageUsed();
+	//data units: thousands of 512-byte units, rounded up
+	Put128(log + 32, (g_smart.units512Read + 999) / 1000);
+	Put128(log + 48, (g_smart.units512Written + 999) / 1000);
+	Put128(log + 64, g_smart.hostReadCommands);
+	Put128(log + 80, g_smart.hostWriteCommands);
+	Put128(log + 112, g_smart.powerCycles);
+	Put128(log + 144, g_smart.unsafeShutdowns);
+	Put128(log + 160, g_smart.mediaErrors);
+}
diff --git a/firmware/smart.h b/firmware/smart.h
