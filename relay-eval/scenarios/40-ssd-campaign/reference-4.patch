diff --git a/firmware/trim.c b/firmware/trim.c
new file mode 100644
index 0000000..9740f61
--- /dev/null
+++ b/firmware/trim.c
@@ -0,0 +1,89 @@
+//////////////////////////////////////////////////////////////////////////////////
+// trim.c: Dataset Management (Deallocate) — docs/design/trim.md
+//
+// A deallocated slice loses its mapping, so GC does not copy it and reads return zero.
+// Its data buffer entry is never flushed (otherwise the old data comes back).
+//////////////////////////////////////////////////////////////////////////////////
+
+#include <string.h>
+#include "xil_printf.h"
+#include "memory_map.h"
+#include "trim.h"
+#include "nvme/host_lld.h"
+
+extern unsigned int storageCapacity_L;
+extern P_DATA_BUF_HASH_TABLE dataBufHashTablePtr;
+
+static unsigned int FindDataBufEntryOfSlice(unsigned int logicalSliceAddr)
+{
+	unsigned int bufEntry = dataBufHashTablePtr->dataBufHash[FindDataBufHashTableEntry(logicalSliceAddr)].headEntry;
+
+	while(bufEntry != DATA_BUF_NONE)
+	{
+		if(dataBufMapPtr->dataBuf[bufEntry].logicalSliceAddr == logicalSliceAddr)
+			return bufEntry;
+		bufEntry = dataBufMapPtr->dataBuf[bufEntry].hashNextEntry;
+	}
+	return DATA_BUF_FAIL;
+}
+
+void DeallocateLogicalSlice(unsigned int logicalSliceAddr)
+{
+	unsigned int bufEntry = FindDataBufEntryOfSlice(logicalSliceAddr);
+
+	if(bufEntry != DATA_BUF_FAIL)
+	{
+		//requests using this entry (DMA, eviction) must finish before it is cleared
+		if(dataBufMapPtr->dataBuf[bufEntry].blockingReqTail != REQ_SLOT_TAG_NONE)
+			SyncAllLowLevelReqDone();
+		dataBufMapPtr->dataBuf[bufEntry].dirty = DATA_BUF_CLEAN;
+		memset((void*)(DATA_BUFFER_BASE_ADDR + bufEntry * BYTES_PER_DATA_REGION_OF_SLICE), 0, BYTES_PER_DATA_REGION_OF_SLICE);
+	}
+
+	InvalidateOldVsa(logicalSliceAddr);
+	logicalSliceMapPtr->logicalSlice[logicalSliceAddr].virtualSliceAddr = VSA_NONE;
+}
+
+static void DeallocateRange(unsigned int startLba, unsigned int length)
+{
+	unsigned int lba = startLba;
+	unsigned int end = startLba + length;
+
+	while(lba < end)
+	{
+		unsigned int lsa = lba / NVME_BLOCKS_PER_SLICE;
+		unsigned int sliceStart = lsa * NVME_BLOCKS_PER_SLICE;
+		unsigned int sliceEnd = sliceStart + NVME_BLOCKS_PER_SLICE;
+
+		if((lba == sliceStart) && (end >= sliceEnd))
+			DeallocateLogicalSlice(lsa);
+		//a part of a slice is handled later (docs/design/trim.md 4)
+
+		lba = sliceEnd;
+	}
+}
+
+void handle_nvme_io_dataset_management(unsigned int cmdSlotTag, NVME_IO_COMMAND *nvmeIOCmd)
+{
+	NVME_COMPLETION nvmeCPL;
+	unsigned int numOfRanges, deallocate, i;
+	P_DSM_RANGE range;
+
+	nvmeCPL.dword[0] = 0;
+	nvmeCPL.specific = 0x0;
+	numOfRanges = (nvmeIOCmd->dword10 & 0xFF) + 1;
+	deallocate = (nvmeIOCmd->dword11 >> 2) & 0x1;
+
+	if(deallocate)
+	{
+		set_direct_rx_dma(DSM_RANGE_BUFFER_ADDR, nvmeIOCmd->PRP1[1], nvmeIOCmd->PRP1[0], numOfRanges * sizeof(DSM_RANGE));
+		check_direct_rx_dma_done();
+		range = (P_DSM_RANGE)DSM_RANGE_BUFFER_ADDR;
+
+		for(i = 0; i < numOfRanges; i++)
+			if(range[i].length && range[i].startingLba[1] == 0)
+				DeallocateRange(range[i].startingLba[0], range[i].length);
+	}
+
+	set_auto_nvme_cpl(cmdSlotTag, nvmeCPL.specific, nvmeCPL.statusFieldWord);
+}
