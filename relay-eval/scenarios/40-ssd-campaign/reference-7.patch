diff --git a/firmware/page_meta.c b/firmware/page_meta.c
new file mode 100644
index 0000000..7eaaa0e
--- /dev/null
+++ b/firmware/page_meta.c
@@ -0,0 +1,64 @@
+//////////////////////////////////////////////////////////////////////////////////
+// page_meta.c: metadata in the user spare of every user data page — docs/design/power-loss.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#include <string.h>
+#include "page_meta.h"
+
+unsigned int g_writeSeq;
+
+unsigned int Crc32(const void* data, unsigned int length)
+{
+	const unsigned char* p = (const unsigned char*)data;
+	unsigned int crc = 0xFFFFFFFF;
+	unsigned int i, k;
+
+	for(i = 0; i < length; i++)
+	{
+		crc ^= p[i];
+		for(k = 0; k < 8; k++)
+			crc = (crc >> 1) ^ (0xEDB88320 & (0 - (crc & 1)));
+	}
+	return ~crc;
+}
+
+void FillPageMeta(unsigned int spareAddr, unsigned int logicalSliceAddr)
+{
+	P_PAGE_META meta = (P_PAGE_META)spareAddr;
+
+	memset(meta, 0xFF, sizeof(PAGE_META));
+	meta->badMark = PAGE_META_BAD_MARK;
+	meta->magic[0] = PAGE_META_MAGIC0;
+	meta->magic[1] = PAGE_META_MAGIC1;
+	meta->version = PAGE_META_VERSION;
+	meta->type = PAGE_META_TYPE_USER_DATA;
+	meta->logicalSliceAddr = logicalSliceAddr;
+	meta->writeSeq = g_writeSeq++;
+	meta->crc = Crc32(meta, 16);
+}
+
+int ParsePageMeta(unsigned int spareAddr, unsigned int* logicalSliceAddr, unsigned int* writeSeq)
+{
+	P_PAGE_META meta = (P_PAGE_META)spareAddr;
+
+	if(meta->magic[0] != PAGE_META_MAGIC0 || meta->magic[1] != PAGE_META_MAGIC1)
+		return 0;
+	if(meta->version != PAGE_META_VERSION || meta->type != PAGE_META_TYPE_USER_DATA)
+		return 0;
+	if(meta->crc != Crc32(meta, 16))
+		return 0;
+	*logicalSliceAddr = meta->logicalSliceAddr;
+	*writeSeq = meta->writeSeq;
+	return 1;
+}
+
+int IsErasedPageMeta(unsigned int spareAddr)
+{
+	const unsigned char* p = (const unsigned char*)spareAddr;
+	unsigned int i;
+
+	for(i = 0; i < sizeof(PAGE_META); i++)
+		if(p[i] != 0xFF)
+			return 0;
+	return 1;
+}
diff --git a/firmware/page_meta.h b/firmware/page_meta.h
new file mode 100644
index 0000000..bd6c39f
--- /dev/null
+++ b/firmware/page_meta.h
@@ -0,0 +1,33 @@
+//////////////////////////////////////////////////////////////////////////////////
+// page_meta.h: metadata in the user spare of every user data page — docs/design/power-loss.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#ifndef PAGE_META_H_
+#define PAGE_META_H_
+
+#define PAGE_META_BAD_MARK		0xFF	//byte 0 is the factory bad block mark position: keep it 0xFF
+#define PAGE_META_MAGIC0		'R'
+#define PAGE_META_MAGIC1		'M'
+#define PAGE_META_VERSION		1
+
+#define PAGE_META_TYPE_USER_DATA	1
+
+typedef struct _PAGE_META {
+	unsigned char badMark;
+	unsigned char magic[2];
+	unsigned char version;
+	unsigned char type;
+	unsigned char reserved0[3];
+	unsigned int logicalSliceAddr;
+	unsigned int writeSeq;
+	unsigned int crc;
+} PAGE_META, *P_PAGE_META;
+
+unsigned int Crc32(const void* data, unsigned int length);
+void FillPageMeta(unsigned int spareAddr, unsigned int logicalSliceAddr);
+int ParsePageMeta(unsigned int spareAddr, unsigned int* logicalSliceAddr, unsigned int* writeSeq);
+int IsErasedPageMeta(unsigned int spareAddr);
+
+extern unsigned int g_writeSeq;
+
+#endif /* PAGE_META_H_ */
