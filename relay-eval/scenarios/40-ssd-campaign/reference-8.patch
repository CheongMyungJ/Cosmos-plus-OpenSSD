--- /dev/null
+++ b/firmware/checkpoint.h
@@ -0,0 +1,39 @@
+//////////////////////////////////////////////////////////////////////////////////
+// checkpoint.h: checkpoint and boot recovery — docs/design/power-loss.md
+//////////////////////////////////////////////////////////////////////////////////
+
+#ifndef CHECKPOINT_H_
+#define CHECKPOINT_H_
+
+#include "ftl_config.h"
+
+//two virtual blocks of die 0 hold checkpoints and are kept out of the user block space
+#define CHECKPOINT_DIE				0
+#define CHECKPOINT_BLOCK0			(USER_BLOCKS_PER_DIE - 2)
+#define CHECKPOINT_BLOCK1			(USER_BLOCKS_PER_DIE - 1)
+#define IsCheckpointBlock(dieNo, blockNo) (((dieNo) == CHECKPOINT_DIE) && (((blockNo) == CHECKPOINT_BLOCK0) || ((blockNo) == CHECKPOINT_BLOCK1)))
+
+#define CHECKPOINT_MAP_BYTES		(SLICES_PER_SSD * 4)
+#define CHECKPOINT_MAP_PAGES		((CHECKPOINT_MAP_BYTES + BYTES_PER_DATA_REGION_OF_PAGE - 1) / BYTES_PER_DATA_REGION_OF_PAGE)
+#define CHECKPOINT_PAGES			(CHECKPOINT_MAP_PAGES + 1)	//map pages, then the header page
+
+#define CHECKPOINT_MAGIC			0x54504B43	//"CKPT"
+#define CHECKPOINT_VERSION			1
+
+typedef struct _CHECKPOINT_HEADER {
+	unsigned int magic;
+	unsigned int version;
+	unsigned int checkpointSeq;		//write sequence when the checkpoint was taken: pages before it are reflected
+	unsigned int mapPages;
+	unsigned int mapCrc;
+	unsigned int headerCrc;			//CRC32 of the fields above
+} CHECKPOINT_HEADER, *P_CHECKPOINT_HEADER;
+
+typedef struct _RECOVERY_SEQ_TABLE {
+	unsigned int seqPlusOne[SLICES_PER_SSD];	//0: no page seen
+} RECOVERY_SEQ_TABLE, *P_RECOVERY_SEQ_TABLE;
+
+void WriteCheckpoint();
+void RecoverFtl();
+
+#endif /* CHECKPOINT_H_ */
